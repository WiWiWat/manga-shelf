# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงจาก Supabase (Project Settings → API Keys)
# .env.local ไม่ถูกส่งขึ้น GitHub (อยู่ใน .gitignore แล้ว)
# ใช้เฉพาะ publishable key เท่านั้น — ห้ามใส่ secret / service_role key ในเว็บฝั่งหน้าบ้าน
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
